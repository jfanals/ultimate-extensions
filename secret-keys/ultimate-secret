#!/usr/bin/env node
// ultimate-secret NAME: print one value from Ultimate's secret store, ~/.ultimate/secrets.json, to stdout with no
// newline, for a config's key command (pi's models.json `"apiKey": "!ultimate-secret NAME"`) or a script's
// `$(ultimate-secret NAME)`. It checks the store as Ultimate's lib/secrets.ts does (no symlink, mode 600, every entry
// valid) but stands alone, so a linked copy works without knowing where the Ultimate clone is. Never run it where its output lands in a
// terminal an agent's transcript records.
import { constants } from 'node:fs'
import { open } from 'node:fs/promises'
import { homedir } from 'node:os'
import { join } from 'node:path'

const fail = (message, code = 1) => {
  process.stderr.write(`ultimate-secret: ${message}\n`)
  process.exit(code)
}
const name = process.argv[2]
if (process.argv.length !== 3 || !/^[A-Z][A-Z0-9_]*$/.test(name ?? ''))
  fail('usage: ultimate-secret NAME (capital letters, digits and _)', 2)
const path = join(process.env.HOME || homedir(), '.ultimate/secrets.json')
let store
try {
  const file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW)
  try {
    if ((await file.stat()).mode & 0o077) fail(`${path} is readable by others; run chmod 600 ${path}`)
    store = JSON.parse(await file.readFile('utf8'))
  } finally {
    await file.close()
  }
} catch (error) {
  if (error.code !== 'ENOENT') fail(`cannot read ${path}: ${error.code ?? 'invalid JSON'}`)
}
// Ultimate's readStore rejects the whole store when one entry breaks its rules; so does this. Messages never show a value.
const valid = (key, item) =>
  /^[A-Z][A-Z0-9_]*$/.test(key) &&
  typeof item?.value === 'string' &&
  item.value.length > 0 &&
  Buffer.byteLength(item.value) <= 16384 &&
  !/[\0\r\n]/.test(item.value) &&
  typeof item.updatedAt === 'string'
const secrets = store?.secrets ?? (store === undefined ? {} : undefined)
if (
  !secrets ||
  typeof secrets !== 'object' ||
  Array.isArray(secrets) ||
  !Object.entries(secrets).every(([key, item]) => valid(key, item))
)
  fail(`invalid secret store; repair ${path} or remove it`)
const value = secrets[name]?.value
if (value === undefined) fail(`${name} is not set; add it in Ultimate's Secrets panel (⌘K → Secrets)`)
process.stdout.write(value)
